---
import { getCollection } from "astro:content";
import PortfolioLayout from "../layouts/PortfolioLayout.astro";
import AboutSlideshow, {
  type AboutSlide,
} from "../components/about/AboutSlideshow.astro";
import ProjectCard from "../components/project-card/ProjectCard.astro";
import aboutCopy from "../content/about.txt?raw";
import "../components/about/about.css";
import "../components/project-card/project-card.css";
import "../components/gallery/gallery.css";
const projects = (
  await getCollection("projects", ({ data }) => !data.draft)
).sort((a, b) => a.data.order - b.data.order);
const finishedProjects = projects.filter(({ data }) => data.status === "finished");
const inProgressProjects = projects.filter(
  ({ data }) => data.status === "in-progress",
);
const images = (await getCollection("gallery")).sort(
  (a, b) => a.data.order - b.data.order,
);
const projectTags = [...new Set(projects.flatMap(({ data }) => data.tags))].sort(
  (a, b) => a.localeCompare(b),
);
const projectIds = new Set(projects.map(({ id }) => id));
interface AboutTextPart {
  text: string;
  projectId?: string;
}
function aboutTextParts(text: string): AboutTextPart[] {
  const parts: AboutTextPart[] = [];
  const projectLinkPattern = /\[([^\]]+)\]\(project:([a-z0-9][a-z0-9-]*)\)/g;
  let textStart = 0;
  for (const match of text.matchAll(projectLinkPattern)) {
    const matchStart = match.index;
    const [source, label, projectId] = match;
    if (!projectIds.has(projectId))
      throw new Error(`About copy references unknown project "${projectId}".`);
    if (matchStart > textStart)
      parts.push({ text: text.slice(textStart, matchStart) });
    parts.push({ text: label, projectId });
    textStart = matchStart + source.length;
  }
  if (textStart < text.length) parts.push({ text: text.slice(textStart) });
  return parts;
}
const aboutBlocks = aboutCopy
  .trim()
  .replaceAll("\r\n", "\n")
  .split("\n\n");
const firstAboutSection = aboutBlocks.findIndex((block) => block.includes("\n"));
const aboutIntroduction = aboutBlocks
  .slice(0, firstAboutSection < 0 ? aboutBlocks.length : firstAboutSection)
  .map(aboutTextParts);
const aboutSectionBlocks =
  firstAboutSection < 0 ? [] : aboutBlocks.slice(firstAboutSection);
const aboutSections = aboutSectionBlocks.map((block) => {
  const [heading, ...body] = block.split("\n");
  return {
    heading,
    items: body.map((line) => aboutTextParts(line.replace(/^- /, ""))),
  };
});
const aboutSlides: AboutSlide[] = [
  {
    src: "/about/slides/img20260916_12255210.webp",
    alt: "Playing at the MCG during half-time break with my buddy.",
    width: 1592,
    height: 2349,
  },
  {
    src: "/about/slides/img20260916_12255211.webp",
    alt: "Arts and crafts at kindergarten.",
    width: 1576,
    height: 2328,
  },
  {
    src: "/about/slides/img4160.webp",
    alt: "I vividly remember losing this finals game.",
    width: 717,
    height: 960,
  },
  {
    src: "/about/slides/img4172.webp",
    alt: "Riding a pony in Fiji.",
    width: 1600,
    height: 1067,
  },
  {
    src: "/about/slides/img4175.webp",
    alt: "Winning my the finals for the first time. We were in the newspaper!",
    width: 1530,
    height: 2048,
  },
  {
    src: "/about/slides/img2167.webp",
    alt: "From the Ha Giang loop in Vietnam last year.",
    width: 1536,
    height: 2048,
  },
];
---

<PortfolioLayout composition="landing">
  <div data-portfolio-shell>
    <h1 class="sr-only">Marcus — Portfolio</h1>
    <p class="sr-only">
      A rotating planet and ring made from real ASCII text. Explore about me,
      projects, and gallery.
    </p>
    <noscript>
      <style is:global>
        body[data-composition="landing"] {
          height: auto;
          overflow: auto;
        }
        .landing-content {
          position: relative;
          pointer-events: auto;
        }
        .portfolio-panel[hidden] {
          display: block !important;
        }
        .primary-nav,
        .menu-notch,
        .scene-controls,
        .project-filters {
          display: none !important;
        }
      </style>
    </noscript>

    <section
      class="portfolio-panel portfolio-panel--about"
      data-panel="about"
      aria-label="About me"
      hidden
    >
      <h2 class="sr-only">About me</h2>
      <article class="about-story">
        <div
          class="about-story__intro"
          data-panel-focus
          tabindex="-1"
        >
          {
            aboutIntroduction.map((paragraph) => (
              <p>
                {paragraph.map(({ text, projectId }) =>
                  projectId ? (
                    <a href={`?ref=${encodeURIComponent(projectId)}#projects`}>
                      {text}
                    </a>
                  ) : (
                    text
                  ),
                )}
              </p>
            ))
          }
        </div>
        {
          aboutSections.map(({ heading, items }) => (
            <section class="about-story__section">
              <h3>{heading}</h3>
              <ul>
                {
                  items.map((item) => (
                    <li>
                      {item.map(({ text, projectId }) =>
                        projectId ? (
                          <a href={`?ref=${encodeURIComponent(projectId)}#projects`}>
                            {text}
                          </a>
                        ) : (
                          text
                        ),
                      )}
                    </li>
                  ))
                }
              </ul>
            </section>
          ))
        }
        <AboutSlideshow slides={aboutSlides} />
      </article>
    </section>

    <section
      class="portfolio-panel portfolio-panel--projects"
      id="projects-panel"
      data-panel="projects"
      data-preload
      data-panel-focus
      aria-label="Projects"
      tabindex="-1"
      hidden
    >
      <h2 class="sr-only">Projects</h2>
      <div class="project-layout" data-project-filters>
        {
          finishedProjects.length > 0 && (
            <section data-project-group aria-label="Finished projects">
              <ul class="project-list">
                {finishedProjects.map((project) => <ProjectCard project={project} />)}
              </ul>
            </section>
          )
        }
        {
          inProgressProjects.length > 0 && (
            <section
              class="project-work-in-progress"
              data-project-group
              aria-labelledby="projects-in-progress"
            >
              <h3 class="project-divider" id="projects-in-progress">in progress</h3>
              <ul class="project-list">
                {inProgressProjects.map((project) => <ProjectCard project={project} />)}
              </ul>
            </section>
          )
        }
        <div
          class="project-scrollbar"
          data-project-scrollbar
          hidden
        >
          <button
            class="project-scrollbar__arrow project-scrollbar__arrow--up"
            data-scroll-direction="-1"
            type="button"
            aria-label="Scroll projects up"
            aria-controls="projects-panel"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m6 15 6-6 6 6"></path>
            </svg>
          </button>
          <div
            class="project-scrollbar__track"
            data-project-scrollbar-track
            role="scrollbar"
            aria-label="Scroll projects"
            aria-controls="projects-panel"
            aria-orientation="vertical"
            aria-valuemin="0"
            aria-valuemax="0"
            aria-valuenow="0"
            tabindex="0"
          >
            <span class="project-scrollbar__thumb" aria-hidden="true"></span>
          </div>
          <button
            class="project-scrollbar__arrow project-scrollbar__arrow--down"
            data-scroll-direction="1"
            type="button"
            aria-label="Scroll projects down"
            aria-controls="projects-panel"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </button>
        </div>
        <aside class="project-filters" aria-label="Project filters">
          <div class="project-filters__heading">
            <span>Filter projects</span>
          </div>
          <div class="project-filters__list">
            {
              projectTags.map((tag) => (
                <button
                  class="project-filter"
                  type="button"
                  data-project-filter={tag.toLowerCase()}
                  aria-pressed="false"
                >
                  {tag}
                </button>
              ))
            }
          </div>
          <div class="project-filters__resets">
            <button
              class="project-filter-reset"
              type="button"
              data-project-filter-reset
              hidden
            >
              reset filter
            </button>
          </div>
        </aside>
        <p class="sr-only" data-project-filter-status aria-live="polite"></p>
      </div>
    </section>

    <section
      class:list={[
        "portfolio-panel",
        images.length === 0 && "portfolio-panel--gallery-construction",
      ]}
      data-panel="gallery"
      aria-label="Gallery"
      hidden
    >
      <h2
        class:list={[images.length === 0 && "sr-only"]}
        data-panel-focus={images.length > 0 ? "" : undefined}
        tabindex={images.length > 0 ? -1 : undefined}
      >
        Gallery
      </h2>
      {
        images.length === 0 ? (
          <div class="gallery-construction" data-panel-focus tabindex="-1">
            <p>under construction!</p>
            <img
              src="/gallery/be-lucky-best-of-luck.gif"
              width="498"
              height="498"
              alt=""
              loading="lazy"
              decoding="async"
            />
          </div>
        ) : (
          <div data-gallery>
            <div class="gallery-grid">
              {images.map(({ data }) => (
                <a
                  class="gallery-item"
                  href={data.src}
                  data-image
                  data-title={data.title}
                  data-caption={data.caption ?? ""}
                >
                  <img
                    src={data.src}
                    width={data.width}
                    height={data.height}
                    alt={data.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  <span>{data.title}</span>
                </a>
              ))}
            </div>
            <dialog class="lightbox" aria-label="Image viewer">
              <button
                class="lightbox-close"
                data-close
                type="button"
                aria-label="Close image viewer"
              >
                Close ×
              </button>
              <figure>
                <img data-full-image alt="" />
                <figcaption data-caption />
              </figure>
              <div class="lightbox-controls">
                <button data-previous type="button" aria-label="Previous image">
                  ←
                </button>
                <span data-count aria-live="polite" />
                <button data-next type="button" aria-label="Next image">
                  →
                </button>
              </div>
            </dialog>
          </div>
        )
      }
    </section>
  </div>
</PortfolioLayout>
