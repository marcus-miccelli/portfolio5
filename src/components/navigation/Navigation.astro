---
import { landingViews } from "../shell/views";
---

<nav class="primary-nav" aria-label="Primary">
  {
    landingViews.map(({ id, menuLabel }) => (
      <button type="button" data-nav-view={id}>
        <span class="nav-label">
          <span class="nav-base">{menuLabel}</span>
          <span class="nav-fog" aria-hidden="true">{menuLabel}</span>
        </span>
        <span class="nav-reveal" aria-hidden="true">
          {menuLabel}
        </span>
      </button>
    ))
  }
</nav>
