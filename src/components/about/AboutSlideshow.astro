---
export interface AboutSlide {
  src: string;
  alt: string;
  width: number;
  height: number;
}

interface Props {
  slides: AboutSlide[];
}

const { slides } = Astro.props;
---

{
  slides.length > 0 && (
    <template data-about-slideshow data-slides={JSON.stringify(slides)}>
    </template>
  )
}
